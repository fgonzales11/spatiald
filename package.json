{
  "name": "tidebound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/start.js",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-hosted.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "generate:workspace": "node scripts/generate-workspace.mjs",
    "generate:national-transmission": "node scripts/generate-us-transmission.mjs",
    "generate:solar-buildings": "node scripts/generate-teco-pv-buildings.mjs",
    "generate:pkl-pv-buildings": "node scripts/generate-teco-pkl-pv-buildings.mjs",
    "index:caltrans-cameras": "node scripts/index-caltrans-cameras.mjs",
    "scrape:solar-counties": "node scripts/scrape-panelcensus-counties.mjs",
    "verify:solar-counties": "node scripts/verify-panelcensus-counties.mjs",
    "generate:test-fixture": "node scripts/generate-demo.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "generate:osm": "python3 scripts/convert-osm.py",
    "prepare:pole": "node scripts/prepare-pole.mjs",
    "analysis:setup": "python3.11 -m venv .venv && .venv/bin/python -m pip install -r analysis_service/requirements.lock.txt",
    "analysis:serve": ".venv/bin/python -m uvicorn analysis_service.app:app --host 127.0.0.1 --port 5181",
    "analysis:test": ".venv/bin/python -m pytest analysis_service/tests -q",
    "analysis:train-pv": ".venv/bin/python -m analysis_service.train_pv"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/extensions": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/maplibre": "^9.4.0",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@takram/three-atmosphere": "0.19.1",
    "@takram/three-clouds": "0.7.6",
    "@takram/three-geospatial": "0.9.1",
    "3d-tiles-renderer": "0.4.24",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "hls.js": "^1.7.3",
    "maplibre-gl": "^6.13.0",
    "postprocessing": "6.39.1",
    "three": "0.180.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0",
    "@deck.gl/mesh-layers": "^9.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "fake-indexeddb": "^6.2.4",
    "geojson-vt": "^5.0.4",
    "vite": "^7.1.0",
    "vt-pbf": "^3.1.3",
    "esbuild": "0.28.2"
  }
}
